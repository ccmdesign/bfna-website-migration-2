# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist
coverage/

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example
# Directus importer output stays ignored; the build-time normaliser output
# (content/bf/**, derived from the committed wireframe snapshots) is tracked so
# `npx nuxt generate` has data on a fresh checkout.
/content/*
!/content/bf/

# Agent-readiness artifacts are generated into .output/public.
/.output/public/**/*.md
/.output/public/sitemap.xml
/.output/public/llms.txt
/.output/public/robots.txt
/.output/public/_headers


_archive/
