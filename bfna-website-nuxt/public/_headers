# Content types for machine-readable files.
# The published copy gains a site-wide robots header outside production.
# src/nuxt.config.ts writes that rule on prerender:done. This source file does not.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff

/agent-instructions.md
  Content-Type: text/markdown; charset=utf-8
  X-Content-Type-Options: nosniff

/openapi.json
  Content-Type: application/json; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/.well-known/mcp
  Content-Type: application/json; charset=utf-8

/api/v1/organization
  Content-Type: application/json; charset=utf-8

/api/v1/navigation
  Content-Type: application/json; charset=utf-8

/api/v1/health
  Content-Type: application/json; charset=utf-8
